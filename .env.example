# AI Model Configuration
# MODEL_TYPE can be 'openai' or 'ollama'
MODEL_TYPE=openai

# OpenAI Configuration (Required if MODEL_TYPE=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Using the course's Vocareum key (like the class Zomato project)? Keep this line.
# Using your own key from platform.openai.com? Delete this line or leave it empty.
OPENAI_BASE_URL=https://openai.vocareum.com/v1

# Ollama Configuration (Required if MODEL_TYPE=ollama)
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Service URLs (Optional, defaults shown below; docker-compose sets these for you)
# MCP_SERVER_URL=http://mcp_server:8003/sse
# ORDER_SERVICE_URL=http://order_service:8001
# POLICY_SERVICE_URL=http://policy_service:8002
# ESCALATION_SERVICE_URL=http://escalation_service:8004
# BACKEND_URL=http://agent:8000
